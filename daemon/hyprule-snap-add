#!/usr/bin/env python3
# hyprule-snap-add CATEGORY CLASS_KEYWORD
# Adds CLASS_KEYWORD (lowercased) to CATEGORY's keyword list in ~/.config/hyprule/snap.json.
# Used by the hyprule app so it never has to hand-edit JSON in C++. Idempotent.
import json
import sys
from pathlib import Path

CONFIG = Path.home() / ".config" / "hyprule" / "snap.json"


def main():
    if len(sys.argv) != 3:
        print("usage: hyprule-snap-add CATEGORY CLASS_KEYWORD", file=sys.stderr)
        return 2
    category, keyword = sys.argv[1], sys.argv[2].strip().lower()
    if not keyword:
        return 2
    try:
        cfg = json.loads(CONFIG.read_text())
    except Exception as e:
        print(f"cannot read {CONFIG}: {e}", file=sys.stderr)
        return 1
    cats = cfg.setdefault("categories", {})
    cat = cats.setdefault(category, {"ws": 11 if category == "Emulator" else 12, "keywords": []})
    kws = cat.setdefault("keywords", [])
    if keyword not in [k.lower() for k in kws]:
        kws.append(keyword)
        CONFIG.write_text(json.dumps(cfg, indent=2) + "\n")
        print(f"added '{keyword}' to {category}")
    else:
        print(f"'{keyword}' already in {category}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
